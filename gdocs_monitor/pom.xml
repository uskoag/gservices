<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.uskoag</groupId>
        <artifactId>uskoag-gservices-parent</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>uskoag-gservices-gdocs_monitor</artifactId>
    <packaging>jar</packaging>

    <description>uskoag-gdocsmon: a tray daemon that watches Google Docs comment threads and wakes a Claude Code session when the owner (or someone the owner approves) asks the AI something. PRP 09, proof of concept.</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <main.class>uskoag.gservices.gdocsmon.Main</main.class>
        <cli.name>uskoag-gdocsmon</cli.name>
        <javafx.ver>25.0.2</javafx.ver>
        <luvjfx.ver>1.0</luvjfx.ver>
        <javafx.classifier>win</javafx.classifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.ver}</version>
        </dependency>
        <dependency>
            <groupId>io.github.luvml</groupId>
            <artifactId>luvjfx</artifactId>
            <version>${luvjfx.ver}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${cli.name}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The cmdtools launcher(s), built by jr-maven-plugin with the config baked in (replaces the .jrc):
         mvn -Djrexe -Djr.installDir=<folder on PATH> package -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution>
                                <id>uskoag-gdocsmon</id>
                                <goals><goal>exe</goal></goals>
                                <configuration>
                                    <name>uskoag-gdocsmon</name>
                                    <jar>C:\user\code\uskoag\gservices\gdocs_monitor\target\uskoag-gdocsmon.jar</jar>
                                    <jvmMode>dll</jvmMode>
                                    <aot>true</aot>
                                    <vmArgs><vmArg>--enable-native-access=ALL-UNNAMED</vmArg><vmArg>-Dfile.encoding=UTF-8</vmArg></vmArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
