<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.uskoag</groupId>
    <artifactId>uskoag-gservices-parent</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <description>Parent POM for Google Services (OAuth, Sheets, Docs, Drive, Slides, YouTube, Gmail) with centralized dependency management</description>

    <modules>
        <module>oauth</module>
        <module>oauth_vault</module>
        <module>sheets</module>
        <module>drive</module>
        <module>docs</module>
        <module>slides</module>
        <module>youtube</module>
        <module>gmail</module>
        <module>calendar</module>
        <module>spreadsheet_cli</module>
        <module>gmail_cli</module>
        <module>gslides_cli</module>
        <module>gsheetsdb</module>
        <module>gcalendar_cli</module>
    </modules>

    <!--
      The gdrive subsystem moved out to the uskoag/gdrive repository (C:\user\code\uskoag\gdrive) and
      is now a self-standing reactor with its own parent. It still consumes uskoag-gservices-drive and
      uskoag-gservices-oauth, but as ordinary released dependencies resolved from the local repository —
      so a change to either must be `mvn install`ed here before gdrive will see it.
    -->


    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Google API versions -->
        <google.api.client.ver>2.2.0</google.api.client.ver>
        <google.oauth.client.jetty.ver>1.34.1</google.oauth.client.jetty.ver>
        <google.sheets.ver>v4-rev20240826-2.0.0</google.sheets.ver>
        <google.drive.ver>v3-rev20240914-2.0.0</google.drive.ver>
        <google.docs.ver>v1-rev20251110-2.0.0</google.docs.ver>
        <google.slides.ver>v1-rev20250401-2.0.0</google.slides.ver>
        <google.youtube.ver>v3-rev20250714-2.0.0</google.youtube.ver>
        <google.gmail.ver>v1-rev20251201-2.0.0</google.gmail.ver>
        <google.calendar.ver>v3-rev20260517-2.0.0</google.calendar.ver>

        <!-- CLI tooling -->
        <gson.ver>2.10.1</gson.ver>
        <h2.ver>2.4.240</h2.ver>
        <jsoup.ver>1.21.1</jsoup.ver>
        <jakarta.mail.ver>2.0.1</jakarta.mail.ver>
        <unicode.console.ver>1.0</unicode.console.ver>
    </properties>

</project>
