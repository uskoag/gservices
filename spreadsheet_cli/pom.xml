<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.uskoag</groupId>
        <artifactId>uskoag-gservices-parent</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>uskoag-gservices-spreadsheet_cli</artifactId>
    <packaging>jar</packaging>

    <description>Command-line tool for testing Google Sheets operations (read/write cells and ranges)</description>

    <dependencies>
        <dependency>
            <groupId>io.github.uskoag</groupId>
            <artifactId>uskoag-gservices-sheets</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          The wallet client, and only the client: a thin protocol jar with no engine, no ArcadeDB and no
          JavaFX behind it. It contributes a CredentialSource through ServiceLoader, so this binary uses
          a wallet when one is installed and falls back to the console app-key prompt when none is.

          Note the direction. The gservices *libraries* stay wallet-free — anyone embedding
          uskoag-gservices-sheets is untouched by this. Only the end-user binary, itself an application,
          carries it. Build order on a clean machine: gservices libraries, then uskoag/wallet, then this.
        -->
        <dependency>
            <groupId>io.github.uskoag</groupId>
            <artifactId>uskoag-wallet-wire</artifactId>
            <version>1.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-sheets</artifactId>
            <version>${google.sheets.ver}</version>
        </dependency>

        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google.api.client.ver}</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.ver}</version>
        </dependency>

        <!-- In-memory SQL engine backing the `query` command -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.ver}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Shade Plugin to create fat JAR with all dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>uskoag.gservices.SpreadsheetCli</mainClass>
                                </transformer>
                            </transformers>
                            <finalName>uskoag-sheetcli</finalName>
                            <filters>
                                <filter>
                                    <!-- Exclude signature files to avoid security exceptions -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Pre-warm the JRC AOT cache right after packaging so the first
                agent invocation is always noise-free.  Running 'listperms'
                (no Google auth required) triggers the JRC launcher to build
                the AOT cache during 'mvn package' rather than on first use.
                Skip on CI or wherever the JRC launcher isn't on PATH:
                    mvn package -Dskip.aot.warmup=true
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>warm-aot-cache</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.aot.warmup}</skip>
                            <target>
                                <!-- failonerror=false: build succeeds even if launcher not on PATH -->
                                <exec executable="uskoag-sheetcli.exe" failonerror="false" resultproperty="aot.warmup.result">
                                    <arg value="listperms"/>
                                </exec>
                                <echo message="AOT warmup exit code: ${aot.warmup.result}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- Set to true on CI or where uskoag-sheetcli.exe is not on PATH -->
        <skip.aot.warmup>false</skip.aot.warmup>
    </properties>
</project>
